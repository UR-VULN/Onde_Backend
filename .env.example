# 로컬 실행용 환경 변수 예시
# 이 파일을 .env 로 복사한 뒤 값을 채우세요. (.env 는 .gitignore 로 제외됩니다)
# 두 모듈 모두 spring-dotenv 로 프로젝트 루트의 .env 를 읽습니다.

# --- Database (MariaDB) ---
DB_URL=jdbc:mariadb://localhost:3306/onde
DB_USERNAME=onde
DB_PASSWORD=

# --- Redis (Refresh Token, 이메일 인증번호, 분산 락) ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- JWT (HS256 서명 키, 32바이트 이상 임의 문자열) ---
JWT_SECRET=

# --- AES (개인정보 컬럼 암호화 키, 정확히 32바이트) ---
AES_SECRET_KEY=

# --- OAuth2 소셜 로그인 (Google Cloud Console / Kakao Developers 에서 발급) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

# --- 메일 (SMTP, Gmail 앱 비밀번호) ---
MAIL_USERNAME=
MAIL_PASSWORD=

# --- 오브젝트 스토리지 (로컬은 MinIO, 운영은 S3) ---
AWS_S3_BUCKET=onde-local
AWS_CLOUDFRONT_DOMAIN=
AWS_REGION=ap-northeast-2
AWS_S3_ENDPOINT=http://localhost:9000
# docker compose 로 띄우는 MinIO 콘솔 계정 (비우면 minioadmin / minioadmin)
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# --- 외부 API: 국세청 사업자등록 진위확인 (공공데이터포털 서비스 키, 선택) ---
NTS_SERVICE_KEY=

# --- 관리자 모듈 헬스체크 허용 IP ---
HEALTH_CHECK_ALLOWED_IP=127.0.0.1

# --- 소셜 로그인 후 리다이렉트할 프론트엔드 주소 (선택, 기본값 http://localhost:5173) ---
APP_FRONTEND_URL=http://localhost:5173
